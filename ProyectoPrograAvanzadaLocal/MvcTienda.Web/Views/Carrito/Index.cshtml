@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = "Mi Carrito";
}

<h2>Mi Carrito</h2>

<table class="table" id="tablaCarrito">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th></th>
        </tr>
    </thead>
    <tbody></tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end"><strong>Total:</strong></td>
            <td id="totalCarrito"></td>
            <td></td>
        </tr>
    </tfoot>
</table>

<button class="btn btn-success" id="btnConfirmar">Confirmar compra</button>

@section scripts{
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
    const API_URL = "https://localhost:44325";

    let carritoId = localStorage.getItem("carritoId");
    if (!carritoId) {
        carritoId = self.crypto.randomUUID();
        localStorage.setItem("carritoId", carritoId);
    }

    // usuarioId viene desde Identity del MVC
    var usuarioId = @(User.Identity.GetUserId<int>());

    $(document).ready(function () {
        cargarCarrito();
        $('#btnConfirmar').click(confirmar);
    });

    function cargarCarrito() {
        $.get(API_URL + '/api/carrito?carritoId=' + carritoId, function (c) {
            let tbody = $('#tablaCarrito tbody');
            tbody.empty();

            if (!c || !c.Items || c.Items.length === 0) {
                tbody.append('<tr><td colspan="5" class="text-center">El carrito está vacío</td></tr>');
                $('#totalCarrito').text('0.00');
                return;
            }

            c.Items.forEach(i => {
                tbody.append(`
                    <tr>
                        <td>${i.NombreProducto}</td>
                        <td>${i.PrecioUnitario.toFixed(2)}</td>
                        <td>
                            <input type="number" min="1" value="${i.Cantidad}"
                                onchange="actualizar(${i.ProductoId}, this.value)" />
                        </td>
                        <td>${(i.PrecioUnitario * i.Cantidad).toFixed(2)}</td>
                        <td>
                            <button onclick="eliminar(${i.ProductoId})" class="btn btn-danger btn-sm">
                                X
                            </button>
                        </td>
                    </tr>
                `);
            });

            $('#totalCarrito').text(c.Total.toFixed(2));
        });
    }

    function actualizar(id, cant) {
        $.ajax({
            url: API_URL + '/api/carrito/actualizar?carritoId=' + carritoId,
            method: 'PUT',
            contentType: 'application/json',
            data: JSON.stringify({
                ProductoId: id,
                Cantidad: parseInt(cant)
            }),
            success: function () {
                cargarCarrito();
            }
        });
    }

    function eliminar(id) {
        $.ajax({
            url: API_URL + '/api/carrito/eliminar/' + id + '?carritoId=' + carritoId,
            method: 'DELETE',
            success: function () {
                cargarCarrito();
            }
        });
    }

    function confirmar() {
        $.post(API_URL + '/api/carrito/confirmar?carritoId=' + carritoId + "&usuarioId=" + usuarioId)
            .done(function (res) {
                alert(res.mensaje);
                window.location.href = '/Ordenes/MisOrdenes';
            })
            .fail(function (xhr) {
                alert("No se pudo confirmar la compra: " + xhr.responseText);
            });
    }
    </script>
}
