@model MvcTienda.Aplicacion.Imagenes.ImagenProductoDto

@{
    ViewBag.Title = "Editar Imagen";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("Edit", "ImagenProducto", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.ImagenProductoId)

    <div class="form-group">
        <label>Imagen Actual:</label><br />
        @if (Model.RutaImagen != null && Model.RutaImagen.Length > 0)
        {
            <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.RutaImagen)"
                 width="200" class="img-thumbnail mb-3" />
        }
    </div>

    <div class="form-group">
        <label>Nueva Imagen (opcional):</label>
        @Html.TextBoxFor(model => model.ArchivoImagen, new { type = "file", @class = "form-control" })
        @Html.ValidationMessageFor(model => model.ArchivoImagen)
    </div>

    <div class="form-group">
        <label>Producto:</label>
        @Html.DropDownListFor(model => model.ProductoId,
            (SelectList)ViewBag.ListaProductos,
            "-- Seleccione --",
            new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.ProductoId)
    </div>

    <div class="form-group">
        <label>Estado:</label>
        <select name="EstadoId" class="form-control">
            <option value="">-- Seleccione --</option>
            <option value="1" @(ViewBag.EstadoId != null && (int)ViewBag.EstadoId == 1 ? "selected" : "")>Activo</option>
            <option value="2" @(ViewBag.EstadoId != null && (int)ViewBag.EstadoId == 2 ? "selected" : "")>Inactivo</option>
            <option value="3" @(ViewBag.EstadoId != null && (int)ViewBag.EstadoId == 3 ? "selected" : "")>Pendiente</option>
        </select>
        @Html.ValidationMessageFor(model => model.EstadoId)
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
}