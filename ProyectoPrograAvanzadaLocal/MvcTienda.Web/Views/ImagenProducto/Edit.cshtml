@model MvcTienda.Aplicacion.Imagenes.ImagenProductoDto

@{
    ViewBag.Title = "Editar Imagen";
}

<h2 class="mb-4">@ViewBag.Title</h2>

@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.ImagenProductoId)

    <div class="form-group">
        <label>Imagen Actual:</label><br />

        @if (Model.RutaImagen != null)
        {
            <img src="data:image/png;base64,@Convert.ToBase64String(Model.RutaImagen)" width="150" class="mb-3" />
        }
    </div>

    <div class="form-group">
        <label>Nueva Imagen (opcional)</label>
        <input type="file" name="imagenArchivo" class="form-control" />
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.ProductoId, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(
                m => m.ProductoId,
                (IEnumerable<SelectListItem>)ViewBag.ListaProductos,
                "--- Seleccione un producto ---",
                new { @class = "form-control" }
            )
            @Html.ValidationMessageFor(model => model.ProductoId, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.EstadoId, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <select name="estadoId" class="form-control">
                <option value="">Estados</option>
                <option value="1" @(ViewBag.EstadoId == 1 ? "selected" : "")>Activos</option>
                <option value="2" @(ViewBag.EstadoId == 2 ? "selected" : "")>Inactivos</option>
                <option value="3" @(ViewBag.EstadoId == 3 ? "selected" : "")>Pendiente</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary ml-2" })
}
