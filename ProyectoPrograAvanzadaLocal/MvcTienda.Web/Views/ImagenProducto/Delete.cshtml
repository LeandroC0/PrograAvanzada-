@model MvcTienda.Aplicacion.Imagenes.ImagenProductoDto

<h2>Eliminar Imagen</h2>
<p>¿Está seguro de eliminar esta imagen?</p>
<hr />

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.ImagenProductoId</dd>

    <dt class="col-sm-3">Producto</dt>
    <dd class="col-sm-9">@Model.ProductoNombre</dd>

    <dt class="col-sm-3">Imagen</dt>
    <dd class="col-sm-9">
        @if (Model.RutaImagen != null)
        {
            <img src="data:image/png;base64,@Convert.ToBase64String(Model.RutaImagen)" width="200" />
        }
    </dd>
</dl>

@using (Html.BeginForm("DeleteConfirmed", "ImagenProducto", new { id = Model.ImagenProductoId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Eliminar</button>
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary ml-2" })
}
