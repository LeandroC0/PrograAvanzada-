@{
    ViewBag.Title = "Listado de Imágenes (API)";
}

<h2 class="text-center mb-4">@ViewBag.Title</h2>

@if (User.IsInRole("Administrador"))
{
    <button class="btn btn-primary mb-3" id="btnAgregar">
        <i class="fas fa-plus"></i> Agregar Imagen
    </button>
}

<table id="tablaImagenes" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Producto</th>
            <th>Estado</th>
            <th>Vista Previa</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>


    @*MODAL CREAR  EDITAR*@

<div class="modal fade" id="modalImagen" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalTitulo"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="imgId" />

                <div class="form-group mb-2">
                    <label class="form-label fw-bold">Producto</label>
                    <select id="productoId" class="form-control form-control-lg">
                        <option value="">--- Seleccione un producto ---</option>
                    </select>
                </div>

                <div class="form-group mb-2">
                    <label>Estado</label>
                    <select id="estadoId" class="form-control">
                        <option value="1">Activo</option>
                        <option value="2">Inactivo</option>
                    </select>
                </div>

                <div class="form-group mb-2">
                    <label>Imagen</label>
                    <input type="file" id="archivoImagen" class="form-control" />
                </div>

                <div id="previewContainer" class="text-center mt-2"></div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-success" id="btnGuardar">Guardar</button>
            </div>

        </div>
    </div>
</div>


  @*MODAL DETALLES*@ 

<div class="modal fade" id="modalDetalles" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Detalles de Imagen</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="detallesContenido"></div>

        </div>
    </div>
</div>


@section scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        const API = "https://localhost:44325/api/imagenes";

        $(document).ready(function () {

            cargarImagenes();

            // CARGAR IMÁGENES EN TABLA

            function cargarImagenes() {
                $.get(API, function (data) {

                    let tbody = $("#tablaImagenes tbody");
                    tbody.empty();

                    data.forEach(item => {

                        let fila = `
                            <tr>
                                <td>${item.ImagenProductoId}</td>
                                <td>${item.ProductoId}</td>
                                <td>${item.EstadoId}</td>
                                <td><img src="data:image/png;base64,${item.ImagenBase64}" width="80" /></td>
                                <td>
                                    <button class="btn btn-info btn-sm btnDetalles" data-id="${item.ImagenProductoId}">
                                        Detalles
                                    </button>

                                    <button class="btn btn-warning btn-sm btnEditar" data-id="${item.ImagenProductoId}">
                                        Editar
                                    </button>

                                    <button class="btn btn-danger btn-sm btnEliminar" data-id="${item.ImagenProductoId}">
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        `;

                        tbody.append(fila);
                    });

                });
            }
            // BOTÓN AGREGAR

            $("#btnAgregar").click(function () {
                limpiarFormulario();
                cargarProductos();
                $("#modalTitulo").text("Agregar Imagen");
                $("#modalImagen").modal("show");
            });

            // GUARDAR CREAR O EDITAR

            $("#btnGuardar").click(function () {

                let id = $("#imgId").val();
                let formData = new FormData();

                formData.append("ProductoId", $("#productoId").val());
                formData.append("EstadoId", $("#estadoId").val());
                formData.append("Archivo", $("#archivoImagen")[0].files[0]);

                let url = id ? `${API}/editar/${id}` : `${API}/crear`;
                let metodo = id ? "PUT" : "POST";

                $.ajax({
                    url: url,
                    type: metodo,
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function () {
                        alert("Guardado correctamente");
                        $("#modalImagen").modal("hide");
                        cargarImagenes();
                        cargarProductos();
                    },
                    error: function (xhr) {
                        alert("ERROR: " + xhr.responseText);
                    }
                });

            });

            // EDITAR

            $(document).on("click", ".btnEditar", function () {

                let id = $(this).data("id");

                $.get(`${API}/${id}`, function (data) {

                    cargarProductos();

                    $("#modalTitulo").text("Editar Imagen");
                    $("#imgId").val(data.ImagenProductoId);
                    $("#productoId").val(data.ProductoId);
                    $("#estadoId").val(data.EstadoId);

                    $("#previewContainer").html(`
                        <img src="data:image/png;base64,${data.ImagenBase64}" width="200" />
                    `);

                    $("#modalImagen").modal("show");
                });
            });

            // DETALLES

            $(document).on("click", ".btnDetalles", function () {
                let id = $(this).data("id");

                $.get(`${API}/${id}`, function (data) {

                    cargarProductos();

                    $("#detallesContenido").html(`
                        <h5>ID: ${data.ImagenProductoId}</h5>
                        <p><strong>Producto ID:</strong> ${data.ProductoId}</p>
                        <p><strong>Estado:</strong> ${data.EstadoId}</p>

                        <img src="data:image/png;base64,${data.ImagenBase64}" width="300" class="img-thumbnail" />
                    `);

                    $("#modalDetalles").modal("show");
                });
            });

            // ELIMINAR
            $(document).on("click", ".btnEliminar", function () {

                let id = $(this).data("id");

                if (!confirm("¿Eliminar imagen?")) return;

                $.ajax({
                    url: `${API}/eliminar/${id}`,
                    type: "DELETE",
                    success: function () {
                        alert("Imagen eliminada");
                        cargarImagenes();
                    }
                });

            });

            // LIMPIAR FORMULARIO
            function limpiarFormulario() {
                $("#imgId").val("");
                $("#productoId").val("");
                $("#estadoId").val("1");
                $("#archivoImagen").val("");
                $("#previewContainer").empty();
            }

        });

        function cargarProductos() {
            $.ajax({
                url: "https://localhost:44325/api/productos",
                type: "GET",
                success: function (data) {

                    let select = $("#productoId");
                    select.empty();
                    select.append('<option value="">--- Seleccione un producto ---</option>');

                    data.forEach(p => {
                        select.append(
                            `<option value="${p.ProductoId}">
                        ${p.Nombre}
                     </option>`
                        );
                    });
                },
                error: function () {
                    alert("Error cargando productos");
                }
            });
        }


    </script>

}
