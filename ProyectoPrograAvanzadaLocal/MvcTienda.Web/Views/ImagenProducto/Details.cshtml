@model MvcTienda.Aplicacion.Imagenes.ImagenProductoDto

<h2>Detalles de Imagen</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.ImagenProductoId</dd>

    <dt class="col-sm-3">Producto</dt>
    <dd class="col-sm-9">@Model.ProductoNombre</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.EstadoNombre</dd>

    <dt class="col-sm-3">Imagen</dt>
    <dd class="col-sm-9">
        @if (Model.RutaImagen != null)
        {
            <img src="data:image/png;base64,@Convert.ToBase64String(Model.RutaImagen)" width="200" />
        }
    </dd>
</dl>

@Html.ActionLink("Editar", "Edit", new { id = Model.ImagenProductoId }, new { @class = "btn btn-warning" })
@Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary ml-2" })
