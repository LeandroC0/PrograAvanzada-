@model MvcTienda.Aplicacion.Estados.EstadoDto

@{
    ViewBag.Title = "Eliminar Estado";
}

<h2>@ViewBag.Title</h2>

<h4>¿Está seguro de que desea eliminar este estado?</h4>
<hr />

<div class="form-horizontal">
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.EstadoId)</dt>
        <dd>@Html.DisplayFor(model => model.EstadoId)</dd>

        <dt>@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd>@Html.DisplayFor(model => model.Nombre)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Eliminar" class="btn btn-danger" /> |
                @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    }
</div>
