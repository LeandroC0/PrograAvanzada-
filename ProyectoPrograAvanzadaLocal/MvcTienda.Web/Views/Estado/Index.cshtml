@model IEnumerable<MvcTienda.Aplicacion.Estados.EstadoDto>

@{
    ViewBag.Title = "Lista de Estados";
}

<h2>Lista de Estados</h2>

<p>
    @if (User.IsInRole("Administrador"))
    {
     @Html.ActionLink("Crear Nuevo Estado", "Create", null, new { @class = "btn btn-success" })
    }
</p>

<table class="table table-striped">
    <thead>
        <tr>
            
            
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>

                    @if (User.IsInRole("Administrador"))
                    {
                       @Html.ActionLink("Detalles", "Details", new { id = item.EstadoId }, new { @class = "btn btn-info btn-sm mx-1" }) 
                       @Html.ActionLink("Editar", "Edit", new { id = item.EstadoId }, new { @class = "btn btn-warning btn-sm mx-1" }) 
                       @Html.ActionLink("Eliminar", "Delete", new { id = item.EstadoId }, new { @class = "btn btn-danger btn-sm" })
                }



                </td>
            </tr>
        }
    </tbody>
</table>
