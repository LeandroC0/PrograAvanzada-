@{
    ViewBag.Title = "Login";
}

<div class="d-flex justify-content-center align-items-center"
     style="min-height: 80vh;">

    <div class="card shadow-lg p-5"
         style="width: 500px; border-radius: 20px;">

        <h2 class="text-center mb-4 fw-bold">Iniciar Sesión</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <!-- Usuario -->
            <div class="mb-4">
                <label class="fw-bold mb-2">Usuario</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="bi bi-person-fill"></i>
                    </span>
                    <input name="usuario"
                           class="form-control"
                           placeholder="Ingresa tu usuario"
                           style="border-radius: 10px; background: #f4f4f4;"
                           required />
                </div>
            </div>

            <!-- Contraseña -->
            <div class="mb-4">
                <label class="fw-bold mb-2">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="bi bi-lock-fill"></i>
                    </span>
                    <input name="password"
                           type="password"
                           class="form-control"
                           placeholder="Ingresa tu contraseña"
                           style="border-radius: 10px; background: #f4f4f4;"
                           required />
                </div>
            </div>

            <button type="submit"
                    class="w-100 py-2"
                    style="font-size: 1.1rem;
                           border-radius: 10px;
                           background: #3b82f6;
                           border: none;
                           color: white;">
                Ingresar
            </button>
        }
    </div>
</div>
