@model IEnumerable<MvcTienda.Aplicacion.Productos.ProductoDto>

@{
    ViewBag.Title = "Lista de Productos";
}

<h2>@ViewBag.Title</h2>

<p>
    @Html.ActionLink("Crear Nuevo Producto", "Create", null, new { @class = "btn btn-success mb-3" })
</p>

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.ProductoId)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Precio)</th>
            <th>@Html.DisplayNameFor(model => model.Inventario)</th>
            <th>@Html.DisplayNameFor(model => model.EstadoId)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.ProductoId)</td>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Precio)</td>
                <td>@Html.DisplayFor(modelItem => item.Inventario)</td>
                <td>@Html.DisplayFor(modelItem => item.EstadoId)</td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.ProductoId }, new { @class = "btn btn-warning btn-sm mr-1" })
                    @Html.ActionLink("Detalles", "Details", new { id = item.ProductoId }, new { @class = "btn btn-info btn-sm mr-1" })
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.ProductoId }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
