@model IEnumerable<MvcTienda.Aplicacion.Productos.ProductoDto>

@{
    ViewBag.Title = "Catálogo de Productos";
    bool isAdmin = User.IsInRole("Administrador");
}

<h2>@ViewData["TituloPagina"]</h2>

@if (isAdmin)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Filtrar Productos</h5>
            @using (Html.BeginForm("Index", "Producto", FormMethod.Get))
            {
                <div class="row">
                    <div class="col-md-5">
                        <input type="text"
                               name="searchTerm"
                               class="form-control"
                               placeholder="Buscar por nombre..."
                               value="@ViewBag.SearchTerm" />
                    </div>
                    <div class="col-md-4">
                        <select name="estadoId" class="form-control">
                            <option value="">Todos los estados</option>
                            <option value="1" @(ViewBag.EstadoId == 1 ? "selected" : "")>Activos</option>
                            <option value="2" @(ViewBag.EstadoId == 2 ? "selected" : "")>Inactivos</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">Buscar</button>
                        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || ViewBag.EstadoId != null)
                        {
                            @Html.ActionLink("Limpiar", "Index", null, new { @class = "btn btn-secondary" })
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (isAdmin)
{
    <p>
        @Html.ActionLink("Crear Nuevo Producto", "Create", null, new { @class = "btn btn-success mb-3" })
    </p>
}

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 col-lg-3 mb-4">
            <div class="card h-100 @(item.EstadoId == 2 ? "border-secondary" : "border-primary")">
                @if (item.EstadoId == 2)
                {
                    <div class="card-header bg-secondary text-white py-1">
                        <small class="float-right">INACTIVO</small>
                    </div>
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Nombre</h5>
                    <p class="card-text flex-grow-1">
                        <strong>Precio:</strong> <span class="text-success">@item.Precio.ToString("C")</span><br />
                        <strong>Disponibles:</strong> @item.Inventario unidades<br />
                        @if (isAdmin)
                        {
                            <span class="badge @(item.EstadoId == 1 ? "badge-success" : "badge-secondary")">
                                @item.EstadoTexto
                            </span>
                        }
                    </p>

                    <div class="mt-auto">
                        <div class="btn-group w-100" role="group">
                            @Html.ActionLink("Ver", "Details", new { id = item.ProductoId },
                                new { @class = "btn btn-outline-info btn-sm" })

                            @if (isAdmin)
                            {
                                @Html.ActionLink("Editar", "Edit", new { id = item.ProductoId },
                                    new { @class = "btn btn-outline-warning btn-sm" })

                                if (item.EstadoId == 1)
                                {
                                    using (Html.BeginForm("ChangeStatus", "Producto", new { id = item.ProductoId, estadoId = 2 }, FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('¿Desactivar este producto?')">
                                            Desactivar
                                        </button>
                                    }
                                }
                                else
                                {
                                    using (Html.BeginForm("ChangeStatus", "Producto", new { id = item.ProductoId, estadoId = 1 }, FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-outline-success btn-sm"
                                                onclick="return confirm('¿Activar este producto?')">
                                            Activar
                                        </button>
                                    }
                                }
                            }
                            else if (item.EstadoId == 1)
                            {
                                <button class="btn btn-primary btn-sm comprar-btn"
                                        data-product-id="@item.ProductoId"
                                        data-product-name="@item.Nombre"
                                        data-product-price="@item.Precio">
                                    Comprar
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3">
        No se encontraron productos.
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">
        @ViewBag.Error
    </div>
}

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success mt-3">
        @ViewBag.Mensaje
    </div>
}

@if (!isAdmin)
{
    <div class="modal fade" id="compraModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Comprar Producto</h5>
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="modalProductName"></p>
                    <p><strong>Precio: </strong><span id="modalProductPrice"></span></p>
                    <div class="form-group">
                        <label for="cantidad">Cantidad:</label>
                        <input type="number" id="cantidad" class="form-control" min="1" value="1">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="confirmarCompra">Confirmar Compra</button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                var currentProductId = null;

                $('.comprar-btn').click(function () {
                    currentProductId = $(this).data('product-id');
                    var productName = $(this).data('product-name');
                    var productPrice = $(this).data('product-price');

                    $('#modalProductName').text(productName);
                    $('#modalProductPrice').text('$' + productPrice);
                    $('#cantidad').val(1);

                    $('#compraModal').modal('show');
                });

                $('#confirmarCompra').click(function () {
                    var cantidad = $('#cantidad').val();

                    // Aquí iría la lógica para procesar la compra
                    alert('Compra confirmada: Producto ID ' + currentProductId + ', Cantidad: ' + cantidad);

                    $('#compraModal').modal('hide');
                });
            });
        </script>
    }
}