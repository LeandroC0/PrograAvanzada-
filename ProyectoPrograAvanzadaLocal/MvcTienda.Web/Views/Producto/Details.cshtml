@model MvcTienda.Aplicacion.Productos.ProductoDto

@{
    ViewBag.Title = "Detalles del Producto";
}

<h2>Detalles del Producto</h2>

<div class="form-horizontal">
    <h4>Producto</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt class="col-md-2">@Html.DisplayNameFor(model => model.ProductoId)</dt>
        <dd class="col-md-10">@Html.DisplayFor(model => model.ProductoId)</dd>

        <dt class="col-md-2">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-md-10">@Html.DisplayFor(model => model.Nombre)</dd>

        <dt class="col-md-2">@Html.DisplayNameFor(model => model.Precio)</dt>
        <dd class="col-md-10">@Html.DisplayFor(model => model.Precio)</dd>

        <dt class="col-md-2">@Html.DisplayNameFor(model => model.Inventario)</dt>
        <dd class="col-md-10">@Html.DisplayFor(model => model.Inventario)</dd>

        <dt class="col-md-2">@Html.DisplayNameFor(model => model.EstadoId)</dt>
        <dd class="col-md-10">@Html.DisplayFor(model => model.EstadoId)</dd>
    </dl>
</div>

<p>
    @if (User.IsInRole("Administrados")){
    @Html.ActionLink("Editar", "Edit", new { id = Model.ProductoId }, new { @class = "btn btn-warning" })
    }

    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-secondary ml-2" })
</p>
