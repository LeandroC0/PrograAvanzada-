@{
    ViewBag.Title = "Cambiar Estado del Producto";
    var id = ViewBag.Id;
}

<h2>Cambiar Estado del Producto</h2>

<h4>¿Está segura que desea cambiar el estado de este producto?</h4>
<hr />

<div class="form-horizontal">
    <dl class="dl-horizontal">
        <dt class="col-md-2">ID</dt>
        <dd class="col-md-10" id="pId"></dd>

        <dt class="col-md-2">Nombre</dt>
        <dd class="col-md-10" id="pNombre"></dd>

        <dt class="col-md-2">Precio</dt>
        <dd class="col-md-10" id="pPrecio"></dd>

        <dt class="col-md-2">Inventario</dt>
        <dd class="col-md-10" id="pInventario"></dd>

        <dt class="col-md-2">Estado actual</dt>
        <dd class="col-md-10" id="pEstado"></dd>
    </dl>

    <div class="form-group">
        <button id="btnCambiar" class="btn btn-danger">Cambiar a Inactivo</button>
        <a href="/ProductosAPI" class="btn btn-secondary ml-2">Volver a la lista</a>
    </div>
</div>

<script>
    const apiBaseUrl = "https://localhost:44325/api/productos";
    const id = "@id";

    $(document).ready(function () {
        $.ajax({
            url: `${apiBaseUrl}/${id}`,
            method: "GET",
            success: function (p) {
                $("#pId").text(p.ProductoId);
                $("#pNombre").text(p.Nombre);
                $("#pPrecio").text(p.Precio);
                $("#pInventario").text(p.Inventario);
                $("#pEstado").text(p.EstadoTexto);
            },
            error: function () {
                alert("Error cargando producto.");
            }
        });
    });

    $("#btnCambiar").click(function () {

        const data = {
            ProductoId: id,
            EstadoId: 2   // 2 = Inactivo
        };

        $.ajax({
            url: `${apiBaseUrl}/${id}`,
            method: "PUT",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                alert("Estado cambiado a INACTIVO exitosamente.");
                window.location.href = "/ProductosAPI";
            },
            error: function (xhr) {
                alert("Error al cambiar estado: " + xhr.responseText);
            }
        });
    });
</script>
