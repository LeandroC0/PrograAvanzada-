@{
    ViewBag.Title = "Catálogo de Productos";
    bool isAdmin = User.IsInRole("Administrador");
    bool isLogged = Request.IsAuthenticated;
    bool isUser = isLogged && !isAdmin;
}

<h2>Catálogo de Productos</h2>

@if (isAdmin)
{
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <label><strong>Filtrar:</strong></label>
                <select id="filtroEstado" class="form-control w-100 d-inline-block ms-2">
                    <option value="0">Todos</option>
                    <option value="1">Activos</option>
                    <option value="2">Inactivos</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" id="btnAbrirCrear">
                    <i class="fas fa-plus"></i> Crear Producto
                </button>

                <i class="fas fa-plus"></i>@Html.ActionLink("Imágenes de los Productos", "Index", "ImagenProducto", null, new { @class = "btn btn-primary" })

            </div>
        </div>
    </div>
}

<div class="row" id="productosContainer"></div>

<div class="modal fade" id="modalProducto" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="tituloModal"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="productoId" />

                <div class="form-group mb-2">
                    <label>Nombre:</label>
                    <input type="text" id="nombre" class="form-control" />
                </div>

                <div class="form-group mb-2">
                    <label>Precio:</label>
                    <input type="number" id="precio" class="form-control" />
                </div>

                <div class="form-group mb-2">
                    <label>Inventario:</label>
                    <input type="number" id="inventario" class="form-control" />
                </div>

                <div class="form-group mb-2">
                    <label>Estado:</label>
                    <select id="estadoId" class="form-control">
                        <option value="1">Activo</option>
                        <option value="2">Inactivo</option>
                    </select>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button id="btnGuardarProducto" class="btn btn-primary">Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalles" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Detalles del Producto</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <h4 id="detNombre"></h4>

                <div id="carouselDetalles" class="carousel slide mb-3">
                    <div class="carousel-inner" id="detCarrusel"></div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselDetalles" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next" type="button" data-bs-target="#carouselDetalles" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>

                <p><strong>Precio:</strong> <span id="detPrecio"></span></p>
                <p><strong>Inventario:</strong> <span id="detInventario"></span></p>
                <p><strong>Estado:</strong> <span id="detEstado"></span></p>

                <div id="containerResennas" class="row">
                    <p class="text-muted">Cargando reseñas...</p>
                </div>

            </div>

        </div>
    </div>
</div>



<script src="/Scripts/jquery-3.7.1.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>

const api = "https://localhost:44325/api/";
const isAdmin = @isAdmin.ToString().ToLower();
const isLogged = @isLogged.ToString().ToLower();
const isUser = @isUser.ToString().ToLower();

carritoId = localStorage.getItem("carritoId");
if (!carritoId) {
    carritoId = self.crypto.randomUUID();
    localStorage.setItem("carritoId", carritoId);
}

$(document).ready(function () {
    cargarProductos();

    if (isAdmin) {
        $("#filtroEstado").change(cargarProductos);
        $("#btnAbrirCrear").click(() => abrirModalCrear());
    }
});


function cargarProductos() {

    $.get(api + "productos", function (productos) {

        if (!isAdmin)
            productos = productos.filter(x => x.EstadoId === 1);

        if (isAdmin) {
            let estado = parseInt($("#filtroEstado").val());
            if (estado !== 0)
                productos = productos.filter(x => x.EstadoId === estado);
        }

        $.get(api + "imagenes", function (imgs) {

            productos.forEach(p => {
                let relacionadas = imgs.filter(i => i.ProductoId === p.ProductoId);

                p.Imagenes = relacionadas.length > 0
                    ? relacionadas.map(i => "data:image/png;base64," + i.ImagenBase64)
                    : ["/Content/img/noimage.png"];
            });

            renderProductos(productos);

        });

    });

}

function renderProductos(list) {

    let html = "";

    list.forEach(p => {

        const estadoBadge = p.EstadoId === 1
            ? `<span class='badge bg-success'>Activo</span>`
            : `<span class='badge bg-secondary'>Inactivo</span>`;

        html += `
<div class="col-md-4 col-lg-3 mb-4">
    <div class="card h-100 shadow">

        <div id="carousel-${p.ProductoId}" class="carousel slide">
            <div class="carousel-inner">
                ${p.Imagenes.map((img, idx) => `
                    <div class="carousel-item ${idx === 0 ? "active" : ""}">
                        <img src="${img}" class="d-block w-100" style="height:180px; object-fit:cover;">
                    </div>`).join("")}
            </div>
        </div>

        <div class="card-body d-flex flex-column">
            <h5>${p.Nombre}</h5>

            <p>
                <strong>Precio:</strong> ${p.Precio}<br>
                <strong>Stock:</strong> ${p.Inventario}<br>
                ${estadoBadge}
            </p>

            <div class="mt-auto btn-group w-100">

                <button class="btn btn-info btn-sm" onclick="verDetalles(${p.ProductoId})">Ver</button>

                ${isAdmin ?
                    ` <button class="btn btn-warning btn-sm" onclick="abrirModalEditar(${p.ProductoId})">Editar</button>
                      <button class="btn btn-${p.EstadoId === 1 ? "danger" : "success"} btn-sm"
                              onclick="cambiarEstado(${p.ProductoId}, ${p.EstadoId === 1 ? 2 : 1})">
                        ${p.EstadoId === 1 ? "Desactivar" : "Activar"}
                      </button>`
                :
                (isUser && p.EstadoId === 1) ?
                    ` <button class="btn btn-success btn-sm agregar-carrito"
                              data-id="${p.ProductoId}" data-nombre="${p.Nombre}">
                          Agregar
                      </button>`
                :
                    ""
                }

            </div>
        </div>
    </div>
</div>`;
    });

    $("#productosContainer").html(html);

    setTimeout(() => {
        document.querySelectorAll(".carousel").forEach(c => {
            new bootstrap.Carousel(c, { interval: 2600 });
        });
    }, 100);
}

    $(document).on("click", ".agregar-carrito", function () {

        let id = $(this).data("id");
        let nombre = $(this).data("nombre");

        $.ajax({
            url: api + "carrito/agregar?carritoId=" + carritoId,
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify({ ProductoId: id, Cantidad: 1 }),
            success: function () {
                alert("Agregado al carrito: " + nombre);
                actualizarContadorCarrito();
            }
        });

    });

function abrirModalCrear() {
    $("#tituloModal").text("Crear Producto");
    $("#productoId").val("");
    $("#nombre").val("");
    $("#precio").val(0);
    $("#inventario").val(0);
    $("#estadoId").val(1);

    $("#btnGuardarProducto").off().click(() => guardarProductoAPI());

    $("#modalProducto").modal("show");
}

function guardarProductoAPI() {

    let dto = {
        Nombre: $("#nombre").val(),
        Precio: parseFloat($("#precio").val()),
        Inventario: parseInt($("#inventario").val()),
        EstadoId: parseInt($("#estadoId").val())
    };

    $.ajax({
        url: api + "productos",
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(dto),
        success: function () {
            alert("Producto creado ✔");
            $("#modalProducto").modal("hide");
            cargarProductos();
        }
    });
}

function abrirModalEditar(id) {

    $("#tituloModal").text("Editar Producto");

    $.get(api + "productos/" + id, function (p) {

        $("#productoId").val(p.ProductoId);
        $("#nombre").val(p.Nombre);
        $("#precio").val(p.Precio);
        $("#inventario").val(p.Inventario);
        $("#estadoId").val(p.EstadoId);

        $("#btnGuardarProducto").off().click(() => actualizarProductoAPI(id));

        $("#modalProducto").modal("show");
    });

}

function actualizarProductoAPI(id) {

    let dto = {
        ProductoId: id,
        Nombre: $("#nombre").val(),
        Precio: parseFloat($("#precio").val()),
        Inventario: parseInt($("#inventario").val()),
        EstadoId: parseInt($("#estadoId").val())
    };

    $.ajax({
        url: api + "productos/" + id,
        method: "PUT",
        contentType: "application/json",
        data: JSON.stringify(dto),
        success: function () {
            alert("Producto actualizado ✔");
            $("#modalProducto").modal("hide");
            cargarProductos();
        }
    });
}

function cambiarEstado(id, nuevoEstado) {

    if (!confirm("¿Confirmar acción?")) return;

    $.ajax({
        url: api + "productos/" + id + "/estado",
        method: "PUT",
        contentType: "application/json",
        data: JSON.stringify({ EstadoId: nuevoEstado }),
        success: function () {
            alert("Estado actualizado ✔");
            cargarProductos();
        }
    });
}

    function verDetalles(id) {

        $("#productoId").val(id);

    $.get(api + "productos/" + id, function (p) {

        $("#detNombre").text(p.Nombre);
        $("#detPrecio").text(p.Precio);
        $("#detInventario").text(p.Inventario);
        $("#detEstado").text(p.EstadoId === 1 ? "Activo" : "Inactivo");

        $.get(api + "imagenes", function (imgs) {

            let relacionadas = imgs.filter(x => x.ProductoId === id);

            let html = "";

            relacionadas.forEach((i, idx) => {
                let src = "data:image/png;base64," + i.ImagenBase64;
                html += `
                    <div class="carousel-item ${idx === 0 ? "active" : ""}">
                        <img src="${src}" class="d-block w-100" style="height:300px; object-fit:cover;">
                    </div>`;
            });

            if (relacionadas.length === 0) {
                html = `
                    <div class="carousel-item active">
                        <img src="/Content/img/noimage.png" class="d-block w-100" style="height:300px; object-fit:cover;">
                    </div>`;
            }

            $("#detCarrusel").html(html);

            new bootstrap.Carousel(document.querySelector('#carouselDetalles'));

            const productoId = $("#productoId").val();
            cargarResennas(productoId);

            $("#modalDetalles").modal("show");
        });

    });
    }

    function cargarResennas(productoId) {

        $.get(api + "resennas/producto/" + productoId, function (resennas) {

            let html = "";

            if (!resennas || resennas.length === 0) {
                html = `<p class="text-muted">Este producto aún no tiene reseñas.</p>`;
            } else {

                resennas.forEach(r => {
                    html += `
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <strong>${r.UsuarioNombre}</strong><br>
                            <span class="text-warning">${"⭐".repeat(r.Calificacion)}</span>

                            <p class="mt-2 mb-1">${r.Comentario}</p>

                            <small class="text-muted">
                                ${new Date(r.Fecha_Resenna).toLocaleDateString()}
                            </small>
                        </div>
                    </div>
                </div>`;
                });
            }

            $("#containerResennas").html(html);
        });
    }


</script>
