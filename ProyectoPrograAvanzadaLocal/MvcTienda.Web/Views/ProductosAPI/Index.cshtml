@{
    ViewBag.Title = "Catálogo de Productos";
    bool isAdmin = User.IsInRole("Administrador");
}

<h2>Catálogo de Productos (API)</h2>

@if (isAdmin)
{
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <label><strong>Filtrar:</strong></label>
                <select id="filtroEstado" class="form-control w-25 d-inline-block ml-2">
                    <option value="0">Todos</option>
                    <option value="1">Activos</option>
                    <option value="2">Inactivos</option>
                </select>
            </div>
            <a href="/ProductosAPI/Crear" class="btn btn-primary">
                <i class="fas fa-plus"></i> Crear Producto
            </a>
        </div>
    </div>
}

@Html.AntiForgeryToken()

<div class="row" id="productosContainer"></div>

@if (!isAdmin)
{
    <div class="modal fade" id="compraModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Comprar Producto</h5>
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="modalProductName"></p>
                    <p><strong>Precio: </strong><span id="modalProductPrice"></span></p>
                    <div class="form-group">
                        <label for="cantidad">Cantidad:</label>
                        <input type="number" id="cantidad" class="form-control" min="1" value="1">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="confirmarCompra">Confirmar Compra</button>
                </div>
            </div>
        </div>
    </div>
}

<script src="/Scripts/jquery-3.7.1.js"></script>

<script>

    var apiBaseUrl = "https://localhost:44325/api/";
    var isAdmin = @((isAdmin).ToString().ToLower());
    var API_URL = "https://localhost:44325";

    let carritoId = localStorage.getItem("carritoId");
    if (!carritoId) {
        carritoId = self.crypto.randomUUID();
        localStorage.setItem("carritoId", carritoId);
    }

    $(document).ready(function () {
        cargarProductos();
        actualizarCarritoNavbar();

        if (isAdmin) {
            $("#filtroEstado").change(function () {
                cargarProductos();
            });
        }
    });

    /**************************************************
     *     CARGAR PRODUCTOS + IMÁGENES RELACIONADAS   *
     **************************************************/
    function cargarProductos() {

        $.ajax({
            url: apiBaseUrl + "productos",
            method: "GET",
            success: function (productos) {

                if (!isAdmin) {
                    productos = productos.filter(x => x.EstadoId === 1);
                }

                if (isAdmin) {
                    const estado = parseInt($("#filtroEstado").val());
                    if (estado !== 0) {
                        productos = productos.filter(x => x.EstadoId === estado);
                    }
                }

                // Cargar imágenes
                $.ajax({
                    url: apiBaseUrl + "imagenes",
                    method: "GET",
                    success: function (imagenes) {

                        // Unir producto ↔ imagen
                        productos.forEach(p => {
                            let imgs = imagenes.filter(i => i.ProductoId === p.ProductoId);

                            if (imgs.length > 0) {
                                p.Imagenes = imgs.map(i => "data:image/png;base64," + i.ImagenBase64);
                            } else {
                                p.Imagenes = ["/Content/img/noimage.png"];
                            }

                        });

                        mostrarProductos(productos);
                    }
                });
            }
        });
    }

    /**************************************************
     *                RENDERIZAR PRODUCTOS            *
     **************************************************/
    function mostrarProductos(data) {

        let html = "";

        data.forEach(p => {

            let badge = p.EstadoId === 1
                ? "<span class='badge badge-success'>Activo</span>"
                : "<span class='badge badge-secondary'>Inactivo</span>";

            html += `
<div class="col-md-4 col-lg-3 mb-4">
    <div class="card h-100 ${p.EstadoId === 2 ? "border-secondary" : "border-primary"}">

        ${p.EstadoId === 2 ? `
        <div class="card-header bg-secondary text-white py-1">
            <small class="float-right">INACTIVO</small>
        </div>` : ""}

        <!-- CAROUSEL Bootstrap 5 -->
        <div id="carousel-${p.ProductoId}" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                ${p.Imagenes.map((img, index) => `
                    <div class="carousel-item ${index === 0 ? "active" : ""}">
                        <img src="${img}" class="d-block w-100" style="height:180px; object-fit:cover;" />
                    </div>
                `).join("")}
            </div>

            ${p.Imagenes.length > 1 ? `
            <button class="carousel-control-prev" type="button" data-bs-target="#carousel-${p.ProductoId}" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carousel-${p.ProductoId}" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
            ` : ""}
        </div>

        <div class="card-body d-flex flex-column">
            <h5 class="card-title">${p.Nombre}</h5>

            <p class="card-text flex-grow-1">
                <strong>Precio:</strong> <span class="text-success">${p.Precio.toLocaleString()}</span><br/>
                <strong>Disponibles:</strong> ${p.Inventario} unidades<br/>
                ${isAdmin ? badge : ""}
            </p>

            <div class="mt-auto">
                <div class="btn-group w-100" role="group">
                    <a class="btn btn-outline-info btn-sm" href="/ProductosAPI/Detalle/${p.ProductoId}">Ver</a>

                    ${isAdmin
                    ? `
                        <a class="btn btn-outline-warning btn-sm" href="/ProductosAPI/Editar/${p.ProductoId}">Editar</a>
                        ${p.EstadoId === 1
                        ? `<button class="btn btn-outline-danger btn-sm cambiar-estado-btn" data-product-id="${p.ProductoId}" data-nuevo-estado="2">Desactivar</button>`
                        : `<button class="btn btn-outline-success btn-sm cambiar-estado-btn" data-product-id="${p.ProductoId}" data-nuevo-estado="1">Activar</button>`
                    }
                        `
                    : `
                        ${p.EstadoId === 1
                        ? `<button class="btn btn-success btn-sm agregar-carrito-btn"
                                       data-product-id="${p.ProductoId}"
                                       data-product-name="${p.Nombre}"
                                       data-product-price="${p.Precio}">
                                    Agregar al carrito
                               </button>`
                        : ""
                    }
                        `
                }
                </div>
            </div>

        </div>
    </div>
</div>`;

        });

        $("#productosContainer").html(html);
    }

    /**************************************************
     *                BOTÓN CAMBIAR ESTADO            *
     **************************************************/
    $(document).on("click", ".cambiar-estado-btn", function () {
        let productId = $(this).data('product-id');
        let nuevoEstado = $(this).data('nuevo-estado');
        let accion = nuevoEstado == 1 ? "activar" : "desactivar";

        if (!confirm(`¿Estás seguro que deseas ${accion} este producto?`)) {
            return;
        }

        let token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '/Producto/ChangeStatus/' + productId,
            method: 'POST',
            data: {
                estadoId: nuevoEstado,
                __RequestVerificationToken: token
            },
            success: function () {
                alert(`Producto ${accion}do correctamente`);
                cargarProductos();
            },
            error: function () {
                alert("No se pudo cambiar el estado del producto");
            }
        });
    });

    /**************************************************
     *               AGREGAR AL CARRITO               *
     **************************************************/
    $(document).on("click", ".agregar-carrito-btn", function () {

        let productId = $(this).data('product-id');
        let productName = $(this).data('product-name');
        let productPrice = $(this).data('product-price');

        $.ajax({
            url: API_URL + '/api/carrito/agregar?carritoId=' + carritoId,
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                productoId: productId,
                cantidad: 1
            }),
            success: function () {
                alert('Agregado al carrito: ' + productName);
                actualizarCarritoNavbar();
            },
            error: function () {
                alert("No se pudo agregar al carrito");
            }
        });
    });

    /**************************************************
     *            ACTUALIZAR ICONO DEL CARRITO        *
     **************************************************/
    function actualizarCarritoNavbar() {
        $.ajax({
            url: API_URL + '/api/carrito?carritoId=' + carritoId,
            method: 'GET',
            success: function (carrito) {

                let totalItems = 0;

                if (carrito && carrito.items) {
                    carrito.items.forEach(i => {
                        totalItems += i.cantidad;
                    });
                }

                if ($("#carritoCantidad").length) {
                    $("#carritoCantidad").text(totalItems);
                }
            },
            error: function () {
                if ($("#carritoCantidad").length) {
                    $("#carritoCantidad").text("0");
                }
            }
        });
    }

</script>
