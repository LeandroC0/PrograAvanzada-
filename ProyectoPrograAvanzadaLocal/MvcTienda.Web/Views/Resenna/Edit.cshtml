@model MvcTienda.Aplicacion.Resennas.ResennaDto

@{
    ViewBag.Title = "Editar Reseña";
}

<h2 class="mb-4">Editar Reseña</h2>

<div class="card">
    <div class="card-body">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ResennaId)
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(model => model.Comentario, new { @class = "form-label" })
                @Html.EditorFor(model => model.Comentario, new { htmlAttributes = new { @class = "form-control" } })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Calificacion, new { @class = "form-label" })
                @Html.EditorFor(model => model.Calificacion, new { htmlAttributes = new { @class = "form-control" } })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Fecha_Resenna, new { @class = "form-label" })
                @Html.EditorFor(model => model.Fecha_Resenna, new { htmlAttributes = new { @class = "form-control", type = "date" } })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.ProductoId, new { @class = "form-label" })
                @Html.DropDownListFor(
                    m => m.ProductoId,
                    (IEnumerable<SelectListItem>)ViewBag.ListaProductos,
                    "--- Seleccione un producto ---",
                    new { @class = "form-control" }
                )
            </div>

            <div class="mb-3">
                @Html.Label("Estado", new { @class = "form-label" })
                <select name="EstadoId" class="form-control">
                    <option value="1" @(Model.EstadoId == 1 ? "selected" : "")>Activo</option>
                    <option value="2" @(Model.EstadoId == 2 ? "selected" : "")>Inactivo</option>
                    <option value="3" @(Model.EstadoId == 3 ? "selected" : "")>Pendiente</option>
                </select>
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.UsuarioId, new { @class = "form-label" })
                @Html.EditorFor(model => model.UsuarioId, new { htmlAttributes = new { @class = "form-control" } })
            </div>

            <button type="submit" class="btn btn-warning w-100">Guardar Cambios</button>
        }

    </div>
</div>

<p class="mt-3">
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-secondary" })
</p>
