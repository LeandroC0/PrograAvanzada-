@model MvcTienda.Aplicacion.Resennas.ResennaDto

@{
    ViewBag.Title = "Crear Reseña";
}

<h2 class="mb-4">Crear Reseña</h2>

<div class="card">
    <div class="card-body">

        @using (Html.BeginForm("Create", "Resenna", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(model => model.Comentario, new { @class = "form-label" })
                @Html.EditorFor(model => model.Comentario, new { htmlAttributes = new { @class = "form-control" } })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Calificacion, new { @class = "form-label" })
                @Html.EditorFor(model => model.Calificacion, new { htmlAttributes = new { @class = "form-control", min = "1", max = "5" } })
            </div>

            <div class="mb-3">
                @Html.EditorFor(model => model.Fecha_Resenna, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-control",
                        type = "date",
                        @Value = ViewBag.Fecha_Resenna
                    }
                })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.ProductoId, new { @class = "form-label" })
                @Html.DropDownListFor(
                    m => m.ProductoId,
                    (IEnumerable<SelectListItem>)ViewBag.ListaProductos,
                    "--- Seleccione un producto ---",
                    new { @class = "form-control" }
                )
            </div>

            <div class="mb-3">
                @Html.Label("Estado", new { @class = "form-label" })
                <select name="EstadoId" class="form-control">
                    <option default value="3">Pendiente</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Usuario</label>
                <input type="text" class="form-control" value="@ViewBag.UsuarioNombre" readonly />
            </div>

            @Html.HiddenFor(model => model.UsuarioId, new { Value = ViewBag.UsuarioId })

            <button type="submit" class="btn btn-success w-100">Crear Reseña</button>
        }

    </div>
</div>

<p class="mt-3">
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-secondary" })
</p>
