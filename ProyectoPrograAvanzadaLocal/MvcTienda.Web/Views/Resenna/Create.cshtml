@model MvcTienda.Aplicacion.Resennas.ResennaDto

@{
    ViewBag.Title = "Crear Reseña";
}

<h2 class="mb-4 text-center fw-bold">
    <i class="bi bi-pencil-square text-primary"></i> Crear Reseña
</h2>

<div class="d-flex justify-content-center">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 650px; border-radius: 15px;">
        <div class="card-body">

            @using (Html.BeginForm("Create", "Resenna", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger text-center mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(model => model.ProductoId, new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(
                        m => m.ProductoId,
                        (IEnumerable<SelectListItem>)ViewBag.ListaProductos,
                        "--- Seleccione un producto ---",
                        new { @class = "form-control form-control-lg" }
                    )
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Calificacion, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.Calificacion, new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control form-control-lg",
                            min = "1",
                            max = "5",
                            placeholder = "Ingresa una calificación del 1 al 5"
                        }
                    })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Comentario, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.Comentario, new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control form-control-lg",
                            placeholder = "Escribe tu comentario..."
                        }
                    })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Fecha_Resenna, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.Fecha_Resenna, new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control form-control-lg",
                            type = "date",
                            @Value = ViewBag.Fecha_Resenna
                        }
                    })
                </div>

                <div class="mb-3">
                    <input type="hidden" name="EstadoId" value="3" />

                    <input type="hidden" name="UsuarioNombre" value="@ViewBag.UsuarioNombre" />
                </div>

                @Html.HiddenFor(model => model.UsuarioId, new { Value = ViewBag.UsuarioId })

                <button type="submit" class="btn btn-primary w-100 btn-lg mt-3" style="border-radius: 10px;">
                    Crear Reseña
                </button>
            }

        </div>
    </div>
</div>

<p class="mt-4 text-center">
    @Html.ActionLink("Volver a la lista", "Index", null,
        new { @class = "btn btn-secondary px-4 py-2", style = "border-radius: 10px;" })
</p>
