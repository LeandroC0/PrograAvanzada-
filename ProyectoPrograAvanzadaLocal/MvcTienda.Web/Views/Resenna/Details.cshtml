@model MvcTienda.Aplicacion.Resennas.ResennaDto

@{
    ViewBag.Title = "Detalles de Reseña";
}

<h2 class="mb-4">Detalles de Reseña</h2>

<div class="card">
    <div class="card-body">

        <h5 class="card-title">Información General</h5>

        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>ID:</strong> @Model.ResennaId</li>
            <li class="list-group-item"><strong>Comentario:</strong> @Model.Comentario</li>
            <li class="list-group-item"><strong>Calificación:</strong> @Model.Calificacion</li>
            <li class="list-group-item"><strong>Fecha:</strong> @Model.Fecha_Resenna.ToString("yyyy-MM-dd")</li>
            <li class="list-group-item"><strong>Producto:</strong> @Model.ProductoNombre</li>
            <li class="list-group-item"><strong>Estado:</strong> @Model.EstadoNombre</li>
            <li class="list-group-item"><strong>Usuario:</strong> @Model.UsuarioNombre</li>
        </ul>

        <div class="mt-3">
            @Html.ActionLink("Editar", "Edit", new { id = Model.ResennaId }, new { @class = "btn btn-warning" })
            @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>

    </div>
</div>
