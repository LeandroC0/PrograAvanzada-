@model IEnumerable<MvcTienda.Aplicacion.Resennas.ResennaDto>

@{
    ViewBag.Title = "Lista de Reseñas";
}

<h2 class="mb-4">Lista de Reseñas</h2>

<p>
    @Html.ActionLink("Crear Nueva Reseña", "Create", null, new { @class = "btn btn-success mb-3" })
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">

                <div class="card-body">
                    <h5 class="card-title">Reseña #@item.ResennaId</h5>

                    <p class="card-text">
                        <strong>Comentario:</strong> @item.Comentario <br />
                        <strong>Calificación:</strong> @item.Calificacion ⭐<br />
                        <strong>Fecha:</strong> @item.Fecha_Resenna.ToString("yyyy-MM-dd") <br />
                        <strong>Producto:</strong> @item.ProductoNombre <br />

                        <!-- AQUÍ SÍ EXISTE EL BADGE -->
                        <strong>Estado:</strong>
                        <span id="estado-@item.ResennaId" class="badge bg-primary">
                            @item.EstadoNombre
                        </span>
                        <br />

                        <strong>Usuario:</strong> @item.UsuarioNombre
                    </p>

                    <div class="d-flex justify-content-between mt-3">
                        @Html.ActionLink("Detalles", "Details", new { id = item.ResennaId }, new { @class = "btn btn-info btn-sm" })
                    </div>
                </div>
            </div>
        </div>
    }
</div>
