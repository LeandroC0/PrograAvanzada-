@model MvcTienda.Aplicacion.Ordenes.OrdenDto

@{
    ViewBag.Title = "Crear Orden";
}

<h2 class="mb-4 text-primary">Crear Orden</h2>

<div class="card shadow-sm">
    <div class="card-body">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Fecha_Orden, new { @class = "form-label fw-bold" })
                @Html.EditorFor(m => m.Fecha_Orden, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                @Html.ValidationMessageFor(m => m.Fecha_Orden, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Total, new { @class = "form-label fw-bold" })
                @Html.EditorFor(m => m.Total, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.Total, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.Label("Usuario", new { @class = "form-label fw-bold" })
                @Html.EditorFor(m => m.UsuarioId, new { htmlAttributes = new { @class = "form-control", placeholder = "ID del Usuario" } })
                @Html.ValidationMessageFor(m => m.UsuarioId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.Label("Estado", new { @class = "form-label fw-bold" })

                <select name="EstadoId" class="form-control">
                    <option value="">Seleccione un estado</option>
                    <option value="1" @(ViewBag.EstadoId == 1 ? "selected" : "")>Activo</option>
                    <option value="2" @(ViewBag.EstadoId == 2 ? "selected" : "")>Inactivo</option>
                    <option value="3" @(ViewBag.EstadoId == 3 ? "selected" : "")>Pendiente</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success w-100 mt-3">
                ✔ Crear Orden
            </button>
        }
    </div>
</div>

<div class="mt-3">
    @Html.ActionLink("← Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>

<style>
    .card {
        border-radius: 10px;
    }

    .form-label {
        font-size: 15px;
    }

    .form-control {
        border-radius: 8px;
        padding: 10px;
    }

    button.btn-success {
        font-size: 16px;
        padding: 12px;
    }

    h2 {
        font-weight: 700;
    }
</style>
