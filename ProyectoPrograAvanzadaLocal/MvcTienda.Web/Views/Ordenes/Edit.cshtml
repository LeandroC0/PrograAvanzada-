@model MvcTienda.Aplicacion.Ordenes.OrdenDto

@{
    ViewBag.Title = "Editar Orden";
}

<h2 class="mb-4">Editar Orden</h2>

<div class="card">
    <div class="card-body">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.OrdenId)

            <div class="mb-3">
                @Html.LabelFor(m => m.Fecha_Orden, new { @class = "form-label" })
                @Html.EditorFor(m => m.Fecha_Orden, new { htmlAttributes = new { @class = "form-control", type = "date" } })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Total, new { @class = "form-label" })
                @Html.EditorFor(m => m.Total, new { htmlAttributes = new { @class = "form-control" } })
            </div>

            <div class="mb-3">
                @Html.Label("Usuario", new { @class = "form-label" })
                @Html.EditorFor(m => m.UsuarioId, new { htmlAttributes = new { @class = "form-control" } })
            </div>

            <div class="mb-3">
                @Html.Label("Estado", new { @class = "form-label" })
                <select name="EstadoId" class="form-control">
                    <option value="1" @(Model.EstadoId == 1 ? "selected" : "")>Activo</option>
                    <option value="2" @(Model.EstadoId == 2 ? "selected" : "")>Inactivo</option>
                    <option value="3" @(Model.EstadoId == 3 ? "selected" : "")>Pendiente</option>
                </select>
            </div>

            <button type="submit" class="btn btn-warning w-100">Guardar Cambios</button>
        }

    </div>
</div>

<p class="mt-3">
    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary" })
</p>
