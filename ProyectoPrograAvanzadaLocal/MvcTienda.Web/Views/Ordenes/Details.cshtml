@model MvcTienda.Aplicacion.Ordenes.OrdenDto

@{
    ViewBag.Title = "Detalles de Orden";
}

<h2 class="mb-4">Detalles de Orden</h2>

<div class="card">
    <div class="card-body">

        <h5 class="card-title">Información General</h5>

        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>ID:</strong> @Model.OrdenId</li>
            <li class="list-group-item"><strong>Fecha:</strong> @Model.Fecha_Orden.ToString("yyyy-MM-dd")</li>
            <li class="list-group-item"><strong>Total:</strong> ₡@Model.Total</li>
            <li class="list-group-item"><strong>Usuario:</strong> @Model.UsuarioNombre</li>
            <li class="list-group-item"><strong>Estado:</strong> @Model.EstadoNombre</li>
        </ul>

        <div class="mt-3">
            @Html.ActionLink("Editar", "Edit", new { id = Model.OrdenId }, new { @class = "btn btn-warning" })
            @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>

    </div>
</div>
