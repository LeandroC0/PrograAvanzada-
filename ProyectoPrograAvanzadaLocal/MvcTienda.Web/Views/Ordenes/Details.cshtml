@model MvcTienda.Aplicacion.Ordenes.OrdenDto

@{
    ViewBag.Title = "Detalles de la Orden";
}

<h2 class="mb-4">Detalles de la Orden #@Model.OrdenId</h2>

<div class="card mb-4">
    <div class="card-body">
        <h4 class="card-title">Información General</h4>

        <p class="card-text">
            <strong>Fecha:</strong> @Model.Fecha_Orden.ToString("dd/MM/yyyy hh:mm tt") <br />
            <strong>Usuario:</strong> @Model.UsuarioNombre <br />
            <strong>Estado:</strong> @Model.EstadoNombre <br />
            <strong>Total:</strong> ₡@Model.Total
        </p>
    </div>
</div>

<h4>Productos de esta Orden</h4>

<table class="table table-bordered table-striped mt-3">
    <thead class="table-dark">
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio Unitario</th>
            <th>Subtotal</th>
        </tr>
    </thead>

    <tbody>
        @if (Model.Detalles != null && Model.Detalles.Any())
        {
            foreach (var d in Model.Detalles)
            {
                <tr>
                    <td>@d.ProductoNombre</td>
                    <td>@d.Cantidad</td>
                    <td>₡@d.PrecioUnitario</td>
                    <td>₡@(d.Subtotal)</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">Esta orden no tiene detalles.</td>
            </tr>
        }


    </tbody>
</table>

<div class="mt-4">
    <a href="@Url.Action("MisOrdenes")" class="btn btn-secondary">← Volver a Mis Órdenes</a>

    @if (User.IsInRole("Administrador"))
    {
        <a href="@Url.Action("Index")" class="btn btn-outline-primary">Ver todas las Órdenes</a>
    }
</div>
