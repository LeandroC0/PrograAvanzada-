@model IEnumerable<MvcTienda.Aplicacion.Ordenes.OrdenDto>

@{
    ViewBag.Title = "Mis Órdenes";
}

<h2>Mis Órdenes</h2>

<table class="table table-striped">
    <thead>
        <tr>
            
            <th>Fecha</th>
            <th>Total</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var o in Model)
            {
                <tr>
                    
                    <td>@o.Fecha_Orden</td>
                    <td>@o.Total</td>
                    <td>@o.EstadoNombre</td>
                    <td>
                        @Html.ActionLink(
                            "Ver detalles",
                            "Details",
                            "Ordenes",
                            new { id = o.OrdenId },
                            new { @class = "btn btn-info btn-sm" }
                        )
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No tienes órdenes registradas.</td>
            </tr>
        }
    </tbody>
</table>
