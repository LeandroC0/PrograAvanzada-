@model IEnumerable<MvcTienda.Aplicacion.Ordenes.OrdenDto>

@{
    ViewBag.Title = "Lista de Órdenes";
}

<h2 class="mb-4">Lista de Órdenes</h2>

<p>
    @Html.ActionLink("Crear Nueva Orden", "Create", null, new { @class = "btn btn-success mb-3" })
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">Orden #@item.OrdenId</h5>

                    <p class="card-text">
                        <strong>Fecha:</strong> @item.Fecha_Orden.ToString("yyyy-MM-dd") <br />
                        <strong>Total:</strong> ₡@item.Total <br />
                        <strong>Usuario:</strong> @item.UsuarioNombre <br />
                        <strong>Estado:</strong> @item.EstadoNombre
                    </p>

                    <div class="d-flex justify-content-between">
                        @Html.ActionLink("Detalles", "Details", new { id = item.OrdenId }, new { @class = "btn btn-info btn-sm" })
                        @Html.ActionLink("Editar", "Edit", new { id = item.OrdenId }, new { @class = "btn btn-warning btn-sm" })
                        @Html.ActionLink("Eliminar", "Delete", new { id = item.OrdenId }, new { @class = "btn btn-danger btn-sm" })
                    </div>

                </div>
            </div>
        </div>
    }
</div>
