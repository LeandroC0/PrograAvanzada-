<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Grupo #4 - Aplicación Web de Comercio Electrónico.T</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-collapse bg-primary-subtle">
        <div class="container">
            @Html.ActionLink("Mvc.TiendaG4", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    @*<li>@Html.ActionLink("Acerca de", "About", "Home", new { area = "" }, new { @class = "nav-link" })</li>
        <li>@Html.ActionLink("Contacto", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>*@
                    @*@if (User.Identity.IsAuthenticated)
        {*@
                    <li>@Html.ActionLink("Productos", "Index", "ProductosAPI", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Resenna", "Index", "Resenna", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Ordenes", "Index", "Ordenes", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Detalle Ordenes", "Index", "DetalleOrden", new { area = "" }, new { @class = "nav-link" })</li>
                    @if (User.IsInRole("Administrador"))
                    {
                        <li>@Html.ActionLink("Estados", "Index", "Estado", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("ImagenProducto", "Index", "ImagenProducto", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Dashboard", "Index", "DashboardAPI", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Moderar Reseñas", "Index", "ResennaApi", null, new { @class = "nav-link" })</li>

                    }
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Carrito")">
                            🛒 Carrito
                            <span id="carritoBadge" class="badge bg-primary">0</span>
                        </a>
                    </li>

                </ul>
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Grupo #4 - Aplicación Web de Comercio Electrónico.</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
